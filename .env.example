# Copy to .env and fill in.

# --- app ---
DJANGO_SECRET_KEY=
DEBUG=True
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=localhost
DEV_IP=127.0.0.1
# VPN_IP=

# --- database ---
DATABASE_ENGINE=postgresql
DATABASE_NAME=magpiecamcoredb
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# --- AWS ---
# AWS_PROFILE=
AWS_REGION=us-west-1
AWS_IMG_DETECTION_BUCKET=
AWS_IMG_PREVIEW_BUCKET=
AWS_VIDEO_CLIP_BUCKET=
# Point at moto in dev (scout-moto:5001 under docker-compose); leave unset for real AWS
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# moto's self-signed cert; only needed when AWS_ENDPOINT_URL points at moto
# AWS_CERT_FILE_PATH=docker/moto/certs/cert.pem

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
# db 1, so the streaming state keys in db 0 stay clear of the task queue.
CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_ML_WORKER_LOG_LEVEL=INFO
# CELERY_STREAMING_COMMAND_WORKER_LOG_LEVEL=INFO
# CELERY_BEAT_LOG_LEVEL=INFO

# --- MediaMTX ---
MEDIAMTX_API_URL=http://localhost:9997

# --- event processing (SQS -> Celery) ---
SQS_QUEUE_NAME=
# SQS_MAX_NUMBER_OF_MESSAGES=10
# SQS_WAIT_TIME_SECONDS=10
# SQS_MAX_RETRY_ATTEMPTS=10
# SQS_RETRY_MODE=adaptive

# --- rules model ---
# api = Gemini API (requirements/worker.txt)
# hosted = local gemma4 weights (requirements/hosted.txt)
ML_MODEL_TYPE=api
# Required when ML_MODEL_TYPE=api
ML_API_MODEL_NAME=gemini-3.1-flash-lite
# Read directly by the google-genai client
GEMINI_API_KEY=

# Required when ML_MODEL_TYPE=hosted
# ML_HOSTED_MODEL_NAME=gemma4-e2b-it
# ML_MODEL_WEIGHTS_DIR=ml_weights
# Backblaze B2 weight storage, read directly by events/ml/weights.py
# OBJ_STORE_ML_BUCKET=
# OBJ_STORE_ENDPOINT_URL=
# OBJ_STORE_ACCESS_KEY_ID=
# OBJ_STORE_SECRET_ACCESS_KEY=

# --- Apple Push Notification service ---
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=
APNS_TEAM_ID=
APNS_URL=https://api.sandbox.push.apple.com:443
APNS_APP_BUNDLE_ID=

# --- moto (local AWS mock, docker-compose) ---
MOTO_PORT=5001

# --- notifications ---
# RULE_TRIGGER_COOLDOWN_MINUTES=2
