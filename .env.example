# Copy to .env and fill in.

# --- app ---
DJANGO_SECRET_KEY=
DEBUG=True
DJANGO_LOGLEVEL=info
DJANGO_ALLOWED_HOSTS=localhost

# --- database ---
DATABASE_ENGINE=postgresql
DATABASE_NAME=scoutcamservicedb
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# --- redis ---
# db 0 is the app's own use, db 1 is the Celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- AWS ---
AWS_REGION=us-west-1
AWS_IMG_DETECTION_BUCKET=
AWS_IMG_PREVIEW_BUCKET=
# Point at moto in dev (scout-moto:5000 under docker-compose); leave unset for real AWS
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- event processing (SQS -> Celery) ---
SQS_QUEUE_NAME=
# SQS_MAX_NUMBER_OF_MESSAGES=10
# SQS_WAIT_TIME_SECONDS=10

# --- rules model ---
# api = Gemini API (requirements/worker.txt)
# hosted = local gemma4 weights (requirements/hosted.txt)
ML_MODEL_TYPE=api
# Required when ML_MODEL_TYPE=api
ML_API_MODEL_NAME=gemini-3.1-flash-lite
# Read directly by the google-genai client
GEMINI_API_KEY=

# Required when ML_MODEL_TYPE=hosted
# ML_HOSTED_MODEL_NAME=gemma4-e2b-it
# ML_MODEL_WEIGHTS_DIR=ml_weights
# Backblaze B2 weight storage, read directly by events/ml/weights.py
# OBJ_STORE_ML_BUCKET=
# OBJ_STORE_ENDPOINT_URL=
# OBJ_STORE_ACCESS_KEY_ID=
# OBJ_STORE_SECRET_ACCESS_KEY=
